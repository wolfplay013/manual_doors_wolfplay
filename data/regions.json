	"Floor Prog 2": {"connects_to": [], "requires": "|Electrical Room Switches| OR |Dam Valves|"},
	"Subfloor Prog":{"connects_to": ["The Backdoor 0"], "requires": ""},

	"The Archives 0": {"connects_to": ["The Archives 1", "Subfloor Prog"], 	"requires": "|Skeleton Key| AND |Lockpick|"},
	"The Archives 1": {"connects_to": [], 									"requires": "|Archives Door|"},

	"The Outdoors 0": {"connects_to": ["The Outdoors 1", "Subfloor Prog"], 	"requires": "|Skeleton Key| AND |Shears|"},
	"The Outdoors 1": {"connects_to": [], 									"requires": "|Outdoors Gate|"},

	"The Stairwell 0": {"connects_to": ["The Stairwell 1", "Subfloor Prog"], "requires": "|Skeleton Key|"},
	"The Stairwell 1": {"connects_to": [], 									 "requires": "|Stairwell Stairs|"},

	"The Backdoor 0": {"connects_to": ["Subfloor Prog"], "requires": ""},
	"The Backdoor 1": {"connects_to": [], "requires": "|Backdoor Key|"}
}
