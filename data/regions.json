{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.regions.schema.json",
	"The Lobby": 	{"connects_to": ["The Hotel 0", "The Mines 0", "Floor Prog 0"], "requires": "", "starting": true},

	"The Hotel 0": 	{"connects_to": ["The Hotel 1"], 								"requires": "|Hotel Key|"},
	"The Hotel 1": 	{"connects_to": ["The Hotel 2", "The Archives 0", "The Outdoors 0"],"requires": "|Library Books|"},
	"The Hotel 2": 	{"connects_to": ["The Mines 0"], 								"requires": "|Electrical Room Switches|"},
	"The Mines 0": 	{"connects_to": ["The Mines 1"], 				  				"requires": "|Generator Fuses|"},
	"The Mines 1": 	{"connects_to": ["The Mines 2", "The Stairwell 0"], 				"requires": "|Nest Anchors|"},
	"The Mines 2": 	{"connects_to": [], 			 								"requires": "|Dam Valves|"},

	"Floor Prog 0": {"connects_to": ["Floor Prog 1", "The Hotel 1", "The Mines 1"], "requirses": "|Hotel Key| OR |Generator Fuses|"},
